generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  course      String
  year        Int      @default(1)
  attendance  Int      @default(0)
  marks       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
